/* block comment
   spanning several lines */
s1: string = "tab\there \"quoted\" back\\slash \0 end";
c1: char = '\n';
c2: char = '\'';
c3: char = '\0';
big: integer = 9223372036854775807;
Fog123: integer = 0; // trailing comment
_underscore: integer = 007;
returned: integer = 1; // IDENT, not the keyword 'return'
